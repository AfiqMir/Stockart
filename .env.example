PORT=5000
# Optional: maximum auth requests per IP per 15 minutes.
# Defaults to 100 locally and 10 when NODE_ENV=production.
# AUTH_RATE_LIMIT_MAX=100
# Checkout/void require MongoDB Atlas or a replica set (not standalone).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
