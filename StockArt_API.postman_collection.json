				{
					"name": "Create Product (Pemilik Only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data._id) {",
									"        pm.environment.set(\"product_id\", jsonData.data._id);",
									"        console.log(\"ID Produk tersimpan:\", jsonData.data._id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nama\": \"Buku Tulis Sidu 38 Lembar\",\n  \"kategori\": \"Alat Tulis\",\n  \"hargaBeli\": 3000,\n  \"hargaJual\": 4500,\n  \"stok\": 50,\n  \"satuan\": \"pcs\",\n  \"stokMinimum\": 10,\n  \"deskripsi\": \"Buku tulis bergaris 38 lembar\",\n  \"aktif\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/products",
							"host": [
								"{{base_url}}"
							],
							"path": [
