						"description": "Mendaftarkan user kasir baru oleh Pemilik Toko (wajib token pemilik)."
					},
					"response": []
				},
				{
					"name": "Login Pemilik",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.environment.set(\"token\", jsonData.token);",
									"        pm.environment.set(\"token_pemilik\", jsonData.token);",
									"        console.log(\"Token Pemilik tersimpan ke environment:\", jsonData.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"pemilik\",\n  \"password\": \"gantidulu123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login sebagai akun Pemilik (token otomatis disimpan ke {{token}} dan {{token_pemilik}})."
					},
					"response": []
				},
