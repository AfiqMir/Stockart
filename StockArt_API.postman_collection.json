					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data._id) {",
									"        pm.environment.set(\"transaction_id\", jsonData.data._id);",
